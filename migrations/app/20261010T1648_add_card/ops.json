        "sql": "CREATE TABLE \"public\".\"Cart\" (\n  \"createdAt\" timestamp(6) DEFAULT (now()) NOT NULL,\n  \"id\" uuid DEFAULT (gen_random_uuid()) NOT NULL,\n  \"itemPrice\" numeric(12,2) NOT NULL,\n  \"items\" json[] DEFAULT '{}' NOT NULL,\n  \"sessionCartId\" text NOT NULL,\n  \"shippingPrice\" numeric(12,2) NOT NULL,\n  \"taxPrice\" numeric(12,2) NOT NULL,\n  \"totalPrice\" numeric(12,2) NOT NULL,\n  \"userId\" uuid,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Cart_items_elem_not_null_ea5c0770\" CHECK (array_position(\"items\", NULL) IS NULL)\n)",
        "params": []
      }
